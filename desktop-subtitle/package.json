{
  "name": "hayamimi-desktop-subtitle",
  "version": "0.3.0",
  "description": "Transparent always-on-top desktop subtitle window for hayamimi's OBS overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win zip"
  },
  "build": {
    "appId": "com.hayamimi.desktop-subtitle",
    "productName": "早耳字幕",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "zip"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3"
  }
}
